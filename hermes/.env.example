# Salin baris yang dibutuhkan ke ~/.hermes/.env
# Descript tidak perlu key: memakai OAuth lewat MCP.

# HelloMinds Builder Access Key (header X-Access-Key)
HELLOMINDS_ACCESS_KEY=
# Base URL Messaging API dari dokumentasi Builder HelloMinds
HELLOMINDS_API_BASE=

# Opsional: override path endpoint jika berbeda dari default di hellominds.py
# HELLOMINDS_PATH_SEND=/conversations/{alias}/messages
